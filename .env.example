# ── LNbits ────────────────────────────────────────────────
LNBITS_URL=#########
LNBITS_ADMIN_KEY=#######

# ── Spark (carteira dedicada do faucet — futura substituição do LNbits) ────
# Mnemonic BIP-39 de 24 palavras + passphrase (25ª palavra). Gerada com
# @buildonspark/spark-sdk, ver SESSAO_BTCFAUCET_CORRECOES_CODEX_DIAGNOSTICO_SPARK.txt
# Só o sidecar (spark-sidecar/) lê estas duas — main.py nunca toca na chave.
SPARK_FAUCET_WALLET_MNEMONIC=
SPARK_FAUCET_WALLET_PASSPHRASE=

# main.py fala com o sidecar por HTTP local. Token: openssl rand -hex 32
SPARK_SIDECAR_URL=http://127.0.0.1:8791
SPARK_SIDECAR_TOKEN=
SPARK_MAX_FEE_SAT=10
# Desligado por padrão — pagamentos continuam via LNbits até a carteira Spark
# ser fundada e testada com um pagamento real (ver checklist na sessão acima).
SPARK_PAYOUTS_ENABLED=false

# LN Address pública (LNURLp) — recebe na carteira Spark, feature independente
# do SPARK_PAYOUTS_ENABLED (só recebe, sem risco de duplo pagamento). CSV de
# usernames que passam a resolver pra carteira Spark em vez do LNbits (mesma
# rota /.well-known/lnurlp/{username} já existente, checado ANTES do proxy).
# "donate" já existia apontando pro LNbits — migrado pra Spark também.
LN_ADDRESS_ENABLED=false
LN_ADDRESS_USERS=doar,donate
LN_ADDRESS_MIN_SATS=1
LN_ADDRESS_MAX_SATS=1000000

# ── hCaptcha ──────────────────────────────────────────────
# Crie conta em hcaptcha.com → Settings → Secret Key
HCAPTCHA_SECRET=######
HCAPTCHA_SITEKEY=########

# ── Anti-bot (PoW + token de fallback) ─────────────────────
# Obrigatório. Sem isto o app não sobe (config.py falha no boot).
# Gere um valor aleatório forte, ex: python3 -c "import secrets; print(secrets.token_hex(32))"
# Assina o desafio de Proof-of-Work e o token do endpoint /api/claim/fallback.
BANNER_SECRET=######


# ── Faucet ────────────────────────────────────────────────
FAUCET_AMOUNT_SAT=21
COOLDOWN_HOURS=24
DB_PATH=faucet.db
